# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Public backend URL for in-process keep-alive health check ping
# In production (e.g. Render), set this to your deployed backend URL:
# BACKEND_URL=https://paisamind-backend-92ig.onrender.com
# For local testing:
BACKEND_URL=http://localhost:5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/paisamind

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Groq AI Service
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Resend Email Service
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
